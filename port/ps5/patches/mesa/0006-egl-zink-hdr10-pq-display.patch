diff --git a/src/egl/main/eglsurface.c b/src/egl/main/eglsurface.c
index 14dc686..653f155 100644
--- a/src/egl/main/eglsurface.c
+++ b/src/egl/main/eglsurface.c
@@ -79,6 +79,14 @@ _eglParseSurfaceAttribList(_EGLSurface *surf, const EGLint *attrib_list)
          case EGL_GL_COLORSPACE_SRGB_KHR:
          case EGL_GL_COLORSPACE_LINEAR_KHR:
             break;
+         case EGL_GL_COLORSPACE_BT2020_PQ_EXT:
+            if (!disp->Extensions.EXT_gl_colorspace_bt2020_pq)
+               err = EGL_BAD_ATTRIBUTE;
+            else if (type != EGL_WINDOW_BIT || surf->Config->RedSize != 10 ||
+                     surf->Config->GreenSize != 10 || surf->Config->BlueSize != 10 ||
+                     surf->Config->AlphaSize != 2)
+               err = EGL_BAD_MATCH;

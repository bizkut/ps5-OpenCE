Subject: egl/surfaceless, zink: HDR10 PQ windows on the PS5 display

Allow a BT.2020 PQ window only with an RGB10_A2 config on the PS5
surfaceless kopper display. Carry its colorspace through the loader and
create the actual drawable and swapchain eagerly so an unavailable matching
HDR10 WSI format fails eglCreateWindowSurface instead of failing later.
SDR keeps its existing swapchain path. RGB10 configs already default on;
the surfaceless visual list and Zink format checks already include B10G10R10A2.

Checked: the changed EGL, DRI and Zink objects cross-compiled using the
PS5 Meson options in an isolated scratch build; no console run.

diff --git a/include/kopper_interface.h b/include/kopper_interface.h
index 7d7fb89..5b17d48 100644
--- a/include/kopper_interface.h
+++ b/include/kopper_interface.h
@@ -104,6 +104,7 @@ struct kopper_display_surface_info {
    struct VkBaseOutStructure *pNext;
    uint32_t width;
    uint32_t height;
+   bool hdr10;
 };
 #endif
 
diff --git a/src/egl/drivers/dri2/platform_surfaceless.c b/src/egl/drivers/dri2/platform_surfaceless.c
index 13c0856..8c250ea 100644
--- a/src/egl/drivers/dri2/platform_surfaceless.c
+++ b/src/egl/drivers/dri2/platform_surfaceless.c
@@ -150,6 +150,15 @@ dri2_surfaceless_create_surface(_EGLDisplay *disp, EGLint type,
 
    if (!dri2_create_drawable(dri2_dpy, config, dri2_surf, dri2_surf))
       goto cleanup_surface;
+#ifdef KOPPER_DISPLAY
+   /* Allocate now so EGL can report failure before the first MakeCurrent. */
+   if (dri2_surf->base.GLColorspace == EGL_GL_COLORSPACE_BT2020_PQ_EXT &&
+       !kopper_validate_display_drawable(dri2_surf->dri_drawable)) {
+      driDestroyDrawable(dri2_surf->dri_drawable);
+      _eglError(EGL_BAD_MATCH, "HDR10 window swapchain unavailable");
+      goto cleanup_surface;
+   }
+#endif
 
    return &dri2_surf->base;
 
@@ -297,6 +306,7 @@ surfaceless_kopper_set_surface_create_info(void *draw,
    display->pNext = NULL;
    display->width = dri2_surf->base.Width;
    display->height = dri2_surf->base.Height;
+   display->hdr10 = dri2_surf->base.GLColorspace == EGL_GL_COLORSPACE_BT2020_PQ_EXT;
    out->present_opaque = true;
    out->initial_swap_interval = 1;
 }
@@ -513,6 +523,8 @@ dri2_initialize_surfaceless(_EGLDisplay *disp)
    dri2_set_WL_bind_wayland_display(disp);
 
 #ifdef KOPPER_DISPLAY
+   if (dri2_dpy->kopper && disp->Extensions.KHR_gl_colorspace)
+      disp->Extensions.EXT_gl_colorspace_bt2020_pq = EGL_TRUE;
    /* (windows on the one display, through kopper) */
    dri2_add_configs_for_visuals(disp, dri2_dpy->kopper ? EGL_WINDOW_BIT | EGL_PBUFFER_BIT : EGL_PBUFFER_BIT);
 #else

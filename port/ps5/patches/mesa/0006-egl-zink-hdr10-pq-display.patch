          default:
             err = EGL_BAD_ATTRIBUTE;
          }
diff --git a/src/gallium/drivers/zink/zink_kopper.c b/src/gallium/drivers/zink/zink_kopper.c
index d9ce0f1..801cde1 100644
--- a/src/gallium/drivers/zink/zink_kopper.c
+++ b/src/gallium/drivers/zink/zink_kopper.c
@@ -101,7 +101,8 @@ kopper_display_key(const struct kopper_displaytarget *cdt)
 {
    const struct kopper_display_surface_info *info =
       (const struct kopper_display_surface_info *)&cdt->info.bos;
-   return (void *)(uintptr_t)((uint64_t)info->width << 32 | info->height);
+   return (void *)(uintptr_t)(((uint64_t)info->width << 32 | info->height) ^
+                              ((uint64_t)info->hdr10 << 63));
 }
 
 /* the one display there is (VideoOut on the PS5), its mode of the surface's
@@ -358,6 +359,11 @@ kopper_CreateSwapchain(struct zink_screen *screen, struct kopper_displaytarget *
           cswap->scci.imageColorSpace = VK_COLOR_SPACE_PASS_THROUGH_EXT;
       else
           cswap->scci.imageColorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+#ifdef KOPPER_DISPLAY
+      if (cdt->type == KOPPER_VK_DISPLAY &&
+          ((const struct kopper_display_surface_info *)&cdt->info.bos)->hdr10)
+         cswap->scci.imageColorSpace = VK_COLOR_SPACE_HDR10_ST2084_EXT;
+#endif
       // TODO: This is where you'd hook up stereo
       cswap->scci.imageArrayLayers = 1;
       cswap->scci.imageUsage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
@@ -436,6 +442,12 @@ kopper_CreateSwapchain(struct zink_screen *screen, struct kopper_displaytarget *
        *result = error;
        return NULL;
    }
+#ifdef KOPPER_DISPLAY
+   if (cswap->scci.imageColorSpace == VK_COLOR_SPACE_HDR10_ST2084_EXT)
+      mesa_logi("zink/kopper: HDR10 swapchain %s colorspace %u",
+                vk_Format_to_str(cswap->scci.imageFormat),
+                (unsigned)cswap->scci.imageColorSpace);
+#endif
    cswap->last_present = UINT32_MAX;
 
    *result = VK_SUCCESS;
@@ -563,6 +575,29 @@ zink_kopper_displaytarget_create(struct zink_screen *screen, unsigned tex_usage,
    cdt->surface = kopper_CreateSurface(screen, cdt);
    if (!cdt->surface)
       goto out;
+#ifdef KOPPER_DISPLAY
+   if (cdt->type == KOPPER_VK_DISPLAY &&
+       ((const struct kopper_display_surface_info *)&cdt->info.bos)->hdr10) {
+      uint32_t count = 0;
+      bool found = false;
+      VkResult result = VKSCR(GetPhysicalDeviceSurfaceFormatsKHR)(screen->pdev, cdt->surface, &count, NULL);
+      VkSurfaceFormatKHR *formats = count ? calloc(count, sizeof(*formats)) : NULL;
+      if (result == VK_SUCCESS && formats) {
+         result = VKSCR(GetPhysicalDeviceSurfaceFormatsKHR)(screen->pdev, cdt->surface, &count, formats);
+         if (result == VK_SUCCESS) {
+            for (uint32_t i = 0; i < count; i++)
+               if (formats[i].format == cdt->formats[0] &&
+                   formats[i].colorSpace == VK_COLOR_SPACE_HDR10_ST2084_EXT)
+                  found = true;
+         }
+      }
+      free(formats);
+      if (!found) {
+         mesa_loge("zink/kopper: matching HDR10 surface format unavailable");
+         goto out;
+      }
+   }
+#endif
 
    if (update_swapchain(screen, cdt, width, height) != VK_SUCCESS)
       goto out;
@@ -615,6 +650,10 @@ zink_kopper_displaytarget_create(struct zink_screen *screen, unsigned tex_usage,
 
 //moar cleanup
 out:
+   if (cdt->swapchain)
+      destroy_swapchain(screen, cdt->swapchain);
+   if (cdt->surface)
+      VKSCR(DestroySurfaceKHR)(screen->instance, cdt->surface, NULL);
    FREE(cdt);
    return NULL;
 }

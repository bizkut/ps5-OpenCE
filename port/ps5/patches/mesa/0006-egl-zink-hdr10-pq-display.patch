diff --git a/src/gallium/frontends/dri/kopper.c b/src/gallium/frontends/dri/kopper.c
index c565d77..bc77b73 100644
--- a/src/gallium/frontends/dri/kopper.c
+++ b/src/gallium/frontends/dri/kopper.c
@@ -504,6 +504,32 @@ kopper_init_drawable(struct dri_drawable *drawable, bool isPixmap, int alphaBits
 #endif
 }
 
+#ifdef KOPPER_DISPLAY
+bool
+kopper_validate_display_drawable(struct dri_drawable *drawable)
+{
+   struct pipe_screen *screen = drawable->screen->base.screen;
+   const struct kopper_display_surface_info *info =
+      (const struct kopper_display_surface_info *)&drawable->info.bos;
+   struct pipe_resource templ = {0};
+   enum pipe_format format;
+   unsigned bind;
+
+   dri_drawable_get_format(drawable, ST_ATTACHMENT_BACK_LEFT, &format, &bind);
+   templ.format = format;
+   templ.target = drawable->screen->target;
+   templ.width0 = info->width;
+   templ.height0 = info->height;
+   templ.depth0 = 1;
+   templ.array_size = 1;
+   templ.bind = bind | PIPE_BIND_DISPLAY_TARGET;
+   drawable->textures[ST_ATTACHMENT_BACK_LEFT] =
+      screen->resource_create_drawable(screen, &templ, &drawable->info);
+   drawable->window_valid = drawable->textures[ST_ATTACHMENT_BACK_LEFT] != NULL;
+   return drawable->window_valid;
+}
+#endif
+
 void
 kopper_destroy_drawable(struct dri_drawable *drawable)
 {

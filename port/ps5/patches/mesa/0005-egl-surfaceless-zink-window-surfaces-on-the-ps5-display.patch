+static EGLBoolean
+dri2_surfaceless_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(draw);
+
+   if (draw->Type != EGL_WINDOW_BIT)
+      return EGL_TRUE;
+   kopperSwapBuffers(dri2_surf->dri_drawable,
+                     __DRI2_FLUSH_CONTEXT | __DRI2_FLUSH_INVALIDATE_ANCILLARY);
+   return EGL_TRUE;
 }
 
+static EGLBoolean
+dri2_surfaceless_swap_interval(_EGLDisplay *disp, _EGLSurface *surf,
+                               EGLint interval)
+{
+   struct dri2_egl_surface *dri2_surf = dri2_egl_surface(surf);
+
+   if (surf->Type == EGL_WINDOW_BIT)
+      kopperSetSwapInterval(dri2_surf->dri_drawable, interval);
+   return EGL_TRUE;
+}

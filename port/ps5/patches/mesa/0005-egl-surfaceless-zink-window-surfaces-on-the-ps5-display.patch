+#ifdef KOPPER_DISPLAY
+/* The one display (VideoOut on the PS5), which Zink's kopper presents to
+ * through VK_KHR_display: the native window is the surface's width and
+ * height, two uint32_t; Zink takes the display mode of that size. */
+static _EGLSurface *
+dri2_surfaceless_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
+                                       void *native_window,
+                                       const EGLint *attrib_list)
+{
+   const uint32_t *extent = native_window;
+
+   if (!dri2_egl_display(disp)->kopper || !extent[0] || !extent[1]) {
+      _eglError(EGL_BAD_NATIVE_WINDOW, "eglCreateWindowSurface");
+      return NULL;
+   }
+   return dri2_surfaceless_create_surface(disp, EGL_WINDOW_BIT, conf,
+                                          attrib_list, extent);

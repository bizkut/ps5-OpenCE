Subject: egl/surfaceless, zink: window surfaces on the PS5's display through kopper

With KOPPER_DISPLAY (the PS5 build), a window surface on EGL's surfaceless
platform is the one display, VideoOut. Its native window is two uint32_t,
the width and height; the surfaceless platform's kopper loader extension
describes it as a display surface (kopper_interface.h's
kopper_display_surface_info), and Zink's kopper makes a VK_KHR_display plane
surface on the display mode of that size, or the first, and presents to it.
Each size is a display target of its own. Zink's instance enables
VK_KHR_display where the driver has it. The surfaceless platform's configs
then take windows too, and eglSwapBuffers and eglSwapInterval reach
kopper.

diff --git a/include/kopper_interface.h b/include/kopper_interface.h
index 7e30277..7d7fb89 100644
--- a/include/kopper_interface.h
+++ b/include/kopper_interface.h
@@ -93,6 +93,20 @@ struct kopper_vk_surface_create_storage {
    intptr_t padding[3];
 };
 
+#ifdef KOPPER_DISPLAY
+/* The one display of a VK_KHR_display device (VideoOut on the PS5): sType
+ * VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR, which marks the kind,
+ * and the size of the surface. Zink takes the display and the mode of that
+ * size itself (VkDisplaySurfaceCreateInfoKHR needs both), as the loader has
+ * no Vulkan handles. */
+struct kopper_display_surface_info {
+   VkStructureType sType;
+   struct VkBaseOutStructure *pNext;
+   uint32_t width;
+   uint32_t height;
+};
+#endif
+
 struct kopper_loader_info {
    struct kopper_vk_surface_create_storage bos;
    int has_alpha;

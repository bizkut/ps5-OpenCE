+#ifdef KOPPER_DISPLAY
+/* the key of a display target in screen->dts: there is one display, and a
+ * window surface on it is its size (each size is a mode of its own, and
+ * VideoOut a set of buffers of its own) */
+static void *
+kopper_display_key(const struct kopper_displaytarget *cdt)
+{
+   const struct kopper_display_surface_info *info =
+      (const struct kopper_display_surface_info *)&cdt->info.bos;
+   return (void *)(uintptr_t)((uint64_t)info->width << 32 | info->height);
+}
+
+/* the one display there is (VideoOut on the PS5), its mode of the surface's
+ * size or else its first, and a plane surface of that size */
+static VkResult
+kopper_create_display_surface(struct zink_screen *screen, const struct kopper_display_surface_info *info,
+                              VkSurfaceKHR *surface)
+{
+   VkDisplayPropertiesKHR display;
+   VkDisplayModePropertiesKHR modes[8];
+   uint32_t count = 1, mode = 0;
+   VkResult error = VKSCR(GetPhysicalDeviceDisplayPropertiesKHR)(screen->pdev, &count, &display);
+   if (error != VK_SUCCESS && error != VK_INCOMPLETE)
+      return error;
+   if (!count)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   count = ARRAY_SIZE(modes);
+   error = VKSCR(GetDisplayModePropertiesKHR)(screen->pdev, display.display, &count, modes);
+   if (error != VK_SUCCESS && error != VK_INCOMPLETE)
+      return error;
+   if (!count)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   for (uint32_t i = 0; i < count; i++) {
+      if (modes[i].parameters.visibleRegion.width == info->width &&
+          modes[i].parameters.visibleRegion.height == info->height) {
+         mode = i;
+         break;
+      }
+   }
+   const VkDisplaySurfaceCreateInfoKHR create_info = {
+      .sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR,
+      .displayMode = modes[mode].displayMode,
+      .transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR,
+      .alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR,
+      .imageExtent = {info->width, info->height},
+   };
+   mesa_logi("zink: kopper on display %s, mode %ux%u at %.3f Hz, surface %ux%u",
+             display.displayName ? display.displayName : "(unnamed)",
+             modes[mode].parameters.visibleRegion.width, modes[mode].parameters.visibleRegion.height,
+             modes[mode].parameters.refreshRate / 1000.0, info->width, info->height);
+   return VKSCR(CreateDisplayPlaneSurfaceKHR)(screen->instance, &create_info, NULL, surface);
+}
+#endif

+#ifdef KOPPER_DISPLAY
+static void
+surfaceless_kopper_get_drawable_info(struct dri_drawable *draw, int *w, int *h,
+                                     void *loaderPrivate)
+{
+   struct dri2_egl_surface *dri2_surf = loaderPrivate;
+
+   *w = dri2_surf->base.Width;
+   *h = dri2_surf->base.Height;
+}
+
+/* a window surface is the one display (kopper_interface.h); a pbuffer
+ * leaves the info empty, which kopper takes as no window */
+static void
+surfaceless_kopper_set_surface_create_info(void *draw,
+                                           struct kopper_loader_info *out)
+{
+   struct dri2_egl_surface *dri2_surf = draw;
+   struct kopper_display_surface_info *display =
+      (struct kopper_display_surface_info *)&out->bos;
+
+   if (dri2_surf->base.Type != EGL_WINDOW_BIT)
+      return;
+   display->sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+   display->pNext = NULL;
+   display->width = dri2_surf->base.Width;
+   display->height = dri2_surf->base.Height;
+   out->present_opaque = true;
+   out->initial_swap_interval = 1;
+}
+
+static const __DRIkopperLoaderExtension surfaceless_kopper_loader_extension = {
+   .base = {__DRI_KOPPER_LOADER, 1},
+   .GetDrawableInfo = surfaceless_kopper_get_drawable_info,
+   .SetSurfaceCreateInfo = surfaceless_kopper_set_surface_create_info,
+};
+
+static const __DRIextension *kopper_loader_extensions[] = {
+   &surfaceless_kopper_loader_extension.base, &image_lookup_extension.base,
+   NULL,
+};
+#else
